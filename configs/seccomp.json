{
  "comment": "Restrictive baseline for the Firecracker jailer. default_action is fail-closed: any syscall not listed is denied. This is a starting profile, not a production-hardened allowlist yet.",
  "default_action": "SCMP_ACT_ERRNO",
  "architectures": ["SCMP_ARCH_X86_64"],
  "syscalls": [
    {
      "action": "SCMP_ACT_ALLOW",
      "names": [
        "read",
        "write",
        "close",
        "exit",
        "exit_group",
        "brk",
        "mmap",
        "munmap",
        "mprotect",
        "rt_sigreturn",
        "rt_sigaction",
        "rt_sigprocmask",
        "nanosleep",
        "clock_gettime",
        "gettimeofday",
        "futex",
        "clone",
        "execve",
        "openat",
        "newfstatat",
        "lseek",
        "getpid",
        "gettid",
        "ioctl",
        "fcntl",
        "prlimit64",
        "set_tid_address",
        "set_robust_list",
        "sigaltstack",
        "arch_prctl",
        "getcwd",
        "readlinkat",
        "getrandom"
      ]
    }
  ]
}
